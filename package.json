{
  "name": "lineage-creative-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "backend": "node --env-file-if-exists=.env backend/server.mjs",
    "backend:dev": "node --watch --env-file-if-exists=.env backend/server.mjs",
    "db:create": "node --env-file-if-exists=.env backend/database/create-database.mjs",
    "db:migrate": "node --env-file-if-exists=.env backend/database/migrate.mjs",
    "db:import-cost-ledger": "node --env-file-if-exists=.env backend/database/import-cost-ledger.mjs",
    "test:product-context": "node --test backend/product-context/service.test.mjs",
    "test:ai-cost": "node --test backend/ai-cost-tracker/ai-cost-tracker.test.mjs",
    "test:database": "node --test backend/database/*.test.mjs",
    "test:pipeline": "node --test backend/pipeline/*.test.mjs",
    "test:context-library": "node --test backend/context-library/*.test.mjs",
    "test:exchange-rates": "node --test backend/integrations/exchange-rates.test.mjs",
    "test:campaign-rules": "node --test lib/campaign-rules.test.mjs lib/merger-rule.test.mjs lib/ad-plan-options.test.mjs lib/generation-setup.test.mjs lib/pipeline.test.mjs lib/persona-avatar.test.mjs",
    "test:meta-metrics": "node --test lib/meta-metrics.test.mjs lib/meta-campaigns.test.mjs lib/imported-metrics.test.mjs lib/business-figures.test.mjs lib/currency.test.mjs lib/ad-columns.test.mjs lib/sync-check.test.mjs",
    "test:creative-exploration": "node --test backend/ai/modes/creative-exploration/*.test.mjs backend/creative-exploration/*.test.mjs",
    "test:target-avatar": "node --test backend/ai/modes/creative-exploration/target-avatars.test.mjs components/target-avatar-tray.test.mjs",
    "test:frontend": "vitest run",
    "test:url-inspection": "node --test backend/url-inspection/url-inspection.test.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.4",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "motion": "^13.1.0",
    "next": "^16.3.0",
    "playwright-core": "^1.62.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unpdf": "^1.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
