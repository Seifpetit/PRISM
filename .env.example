# Select the default provider used by strategy generation.
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini

# Optional shared API key. Leave unset when using provider-specific keys below;
# it takes precedence over them when set.
# AI_API_KEY=

# Add only the providers you plan to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=

# Optional provider-specific model overrides.
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-sonnet-5
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GEMINI_MODEL=gemini-2.5-flash
# PERPLEXITY_MODEL=sonar

BACKEND_PORT=4000

# Local SQLite database. Files matching data/*.db are ignored by Git, except the shared working
# database data/prism.db (private repo). For your own empty database use e.g. data/local.db.
# DATABASE_PATH=data/prism.db

# Append-only JSONL cost ledger. Every persisted row is also logged by the backend.
# AI_COST_LEDGER_PATH=data/ai-cost-ledger.jsonl

# Optional path to an existing Chromium-compatible browser for client-rendered
# storefront inspection. On this Windows workstation, Edge is detected by default.
# URL_INSPECTION_BROWSER_PATH=C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe

# Onboarding integrations (Testing & integrations step).
# Meta Ads: presence of a token is treated as "connected" (dev-set token, no OAuth yet).
# Meta Ads: "Log in with Facebook" for every user. Create an app at developers.facebook.com
# (type Business), add the Facebook Login and Marketing API products, and under Facebook Login
# settings list <backend>/meta/callback (e.g. http://localhost:4000/meta/callback) as a valid OAuth
# redirect URI. While the app is in development mode only people with a role on the app can log in.
# META_APP_ID=
# META_APP_SECRET=
# If the app uses "Facebook Login for Business", create a Configuration in the dashboard (left menu:
# Facebook Login for Business > Configurations) with the ads_read permission, and put its id here.
# The login link then carries this id instead of a scope list:
# META_LOGIN_CONFIG_ID=
# Optional: where the browser returns after Facebook (defaults to SHOPIFY_OAUTH_REDIRECT_BASE, then
# http://localhost:4000), and the permissions asked for (default ads_read):
# META_OAUTH_REDIRECT_BASE=http://localhost:4000
# META_OAUTH_SCOPES=ads_read
# Without META_APP_ID/META_APP_SECRET the Connect button asks for a pasted access token instead.
# A token pasted or dev-set here is a fallback and is ignored when NODE_ENV=production:
# META_ADS_ACCESS_TOKEN=
#
# Shopify: connections are stored per workspace in the database (encrypted). Connect via
# the startShopifyConnection mutation, which uses the Shopify app credentials below.
# INTEGRATION_ENCRYPTION_KEY encrypts stored access tokens; generate 32 random bytes:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# INTEGRATION_ENCRYPTION_KEY=
# SHOPIFY_APP_CLIENT_ID=
# SHOPIFY_APP_CLIENT_SECRET=
# Where the browser is sent back after approving in Shopify. For local development use the backend
# itself (no tunnel needed) and list <this>/shopify/callback in the Shopify app's allowed redirect URLs:
# SHOPIFY_OAUTH_REDIRECT_BASE=http://localhost:4000
# Default store for the Connect button (blank = the button asks which store):
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Where the "Return to PRISM" link points after Shopify connects (default http://localhost:3000):
# APP_BASE_URL=http://localhost:3000
# Dev-only fallback (ignored when NODE_ENV=production): a workspace with no stored
# connection uses this token/store.
# SHOPIFY_ACCESS_TOKEN=

# Profile banner photos (Control room -> Profile). Free key from https://www.pexels.com/api/ - without it the
# picker shows a built-in set of 9. The key stays on the backend; restart it after adding.
# PEXELS_API_KEY=

# Converty (order outcomes: confirmed / delivered / returned). Create the app in Converty under
# Integrations > Apps > Create Custom Integration, list <backend>/converty/callback as a redirect URL
# (e.g. http://localhost:4000/converty/callback), grant Read on Orders, Products, Stores and Hooks, then
# put the generated credentials here. Restart the backend after adding.
# CONVERTY_CLIENT_ID=
# CONVERTY_CLIENT_SECRET=
# Optional: where Converty returns the browser (defaults to SHOPIFY_OAUTH_REDIRECT_BASE, then
# http://localhost:4000), the scopes asked for, and the API host:
# CONVERTY_OAUTH_REDIRECT_BASE=http://localhost:4000
# CONVERTY_OAUTH_SCOPES=read-orders read-products read-stores read-hooks create-hooks
# CONVERTY_OAUTH_BASE=https://partner.converty.shop
# CONVERTY_API_BASE=https://api.converty.shop
